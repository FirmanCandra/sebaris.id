DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Arahkan API dan Storage ke backend Laravel
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]
    RewriteRule ^storage/(.*)$ backend/public/storage/$1 [L]

    # 2. File statis nyata (.js, .css, gambar) disajikan langsung
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Semua rute lainnya diarahkan ke frontend React (SPA)
    RewriteRule ^index\.html$ - [L]
    RewriteRule ^.*$ /index.html [L]
</IfModule>
