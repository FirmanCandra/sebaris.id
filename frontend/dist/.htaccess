<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API dan Storage diteruskan ke Laravel
    RewriteRule ^api(/.*)?$ backend/public/index.php [L,QSA]
    RewriteRule ^storage(/.*)?$ backend/public/storage$1 [L]

    # 2. Sajikan file fisik nyata langsung (js, css, gambar, dll)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Semua rute SPA React (seperti /login, /voting) diarahkan ke index.html
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
